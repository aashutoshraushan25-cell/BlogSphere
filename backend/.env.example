# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/blogsphere
# For Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/blogsphere?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_super_secret_key_here

# Frontend Client URL (For CORS in production)
CLIENT_URL=http://localhost:5000

